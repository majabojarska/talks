{
  "name": "slidev-theme-taloscon2026",
  "version": "0.1.0",
  "private": true,
  "description": "Slidev theme for TalosCon 2026, based on the official master slide deck",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=52.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 960,
      "fonts": {
        "sans": "Manrope",
        "mono": "JetBrains Mono",
        "provider": "none"
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
